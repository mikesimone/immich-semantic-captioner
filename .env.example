# -------- Immich connection --------
IMMICH_URL=http://your-immich-host:2283
IMMICH_API_KEY=REPLACE_ME

# -------- Postgres (inside your Immich docker network) --------
# If you run this compose file in the SAME folder/network as Immich, PGHOST is usually immich_postgres
PGHOST=immich_postgres
PGPORT=5432
PGDATABASE=immich
PGUSER=postgres
PGPASSWORD=postgres

# -------- Captioner behavior --------
BATCH_SIZE=50
SLEEP_SECONDS=0.2
IDLE_SLEEP_SECONDS=60
MAX_CAPTION_CHARS=12000
USER_AGENT=immich-captioner/2.3
DRY_RUN=0
CAPTION_VIDEOS=0

# Keyframe sampling: sparse coverage of the video's "setup", dense fixed-interval
# coverage of the last VIDEO_TAIL_SECONDS (where the action tends to concentrate).
VIDEO_TAIL_SECONDS=240
VIDEO_TAIL_INTERVAL_SECONDS=15
VIDEO_HEAD_FRAME_COUNT=4
MAX_VIDEO_FRAMES=24

ENABLE_TAGS=0

# If 1, detailed captions are instructed to describe sexual content directly
# and explicitly (no euphemisms) instead of writing a sanitized caption.
EXPLICIT_CAPTIONS=1

# Stamp "Date Taken" with the caption time for porn (assets captioned in the compact
# porn format), so freshly-processed material sorts to the top of the timeline for review.
STAMP_PORN_CAPTION_DATE=1


# API-only mode (DEFAULT: true)
# If true: Uses paginated Immich API calls to find uncaptioned assets (safer, no direct DB access, but slower for large libraries).
# If false: Uses direct Postgres query for efficiency (requires valid PG* credentials; riskier if Immich schema changes).
USE_API_ONLY=true


# -------- Florence (OCR pre-pass only) --------
FLORENCE_MODEL=microsoft/Florence-2-large

# -------- JoyCaption (detailed/explicit captions; images + video frames) --------
JOYCAPTION_MODEL=fancyfeast/llama-joycaption-beta-one-hf-llava

# -------- Container base image --------
CUDA_BASE_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

# -------- Legacy identity envs (optional; captioner.py still reads them) --------
IDENTITY_ALBUM_MAP=Lydia=Lydia;Me=Me
IDENTITY_NOUN_HINTS=Lydia=woman,girl,person;Me=man,guy,person
IDENTITY_ENSURE_MODE=prefix

# -------- Upload routing + album-move handling --------
# New uploads (in no album, never processed) are routed in a fixed order before captioning:
# CamSpy -> known person -> anthro -> nudity -> porn categories. Albums the human files
# things into (Multiple Creampie, Single Creampie, 100.000.x) trigger the CumCounter /
# archiving. Needs the PG* settings above even when USE_API_ONLY=true; without them routing
# is switched off and everything is captioned by album only.
ROUTING_ENABLED=1
# Override an album's number: key=number;key=number (keys are listed in captioner.py,
# _DEFAULT_ROUTING_ALBUM_NUMBERS).
ROUTING_ALBUM_NUMBERS=
ROUTING_PERSON_EXCLUDE=Lydia Dog,LydiaDog
FACE_WAIT_GRACE_SECONDS=120
FACE_WAIT_MAX_SECONDS=3600
MOVE_POLL_SECONDS=60
UNCATEGORIZED_CAPTION=Please Categorize
LYDIADOG_PERSON_NAME=Lydia Dog
LYDIADOG_GEN_INFO_KEYWORDS=lydia
LYDIADOG_MIN_SIMILARITY=0.70

# -------- Remote creampie scorer (optional) --------
# porn-classifier's model/serve.py (V-JEPA 2 video model). Multiple Creampie counts ask it
# first and fall back to the frame counter when it's unset, down, busy or times out.
# e.g. http://172.27.0.8:8770 (Anton)
CREAMPIE_SCORER_URL=
CREAMPIE_SCORER_TOKEN=
CREAMPIE_SCORER_TIMEOUT=3600
