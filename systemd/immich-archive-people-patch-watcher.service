[Unit]
Description=Reapply the archive-visibility People patch whenever immich_server restarts
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/opt/captioner/immich-semantic-captioner/scripts/reapply-archive-people-patch-on-restart.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
